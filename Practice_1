#custom exceptions

class CapacityExceededError(Exception):
    pass

def board(passengers, capacity):
    if passengers>capacity:
        raise CapacityExceededError(f"{capacity} is greater then {passengers}")
    else:
        print("Passengers with capacity")

try:
    (board(10,9))
except CapacityExceededError as e:
    print(type(e).__name__,e)

#Classes
class Trip:
    def __init__(self, route_id, hour, passengers):
        if not isinstance(route_id,int) or route_id<0:
            raise TypeError(f"Route: {route_id} cannot be less than zero")
        if not (0 <= hour <= 23):
            raise ValueError("no of hours chas to be between 0 and 23 only")

        

        self.route_id = route_id
        self.hour = hour
        self.passengers = passengers
        self.is_peak = hour>=8


    def get_fare(self):
        fare = self.hour * 5
        if self.is_peak == True:
            fare *=2
        return fare


t1 = Trip(7, 6, 30)
print(t1.get_fare()) # 30 (6*5, not peak)

t2 = Trip(7, 9, 30)
print(t2.get_fare()) # 90 (9*5=45, doubled)

t3 = Trip(7, 8, 30)
print(t3.get_fare()) # 80 (8 counts as peak)

t4 = Trip(7, 0, 30)
print(t4.get_fare()) # 0 (midnight, 0*5)

t5 = Trip(7, 23, 30)
print(t5.is_peak) 


